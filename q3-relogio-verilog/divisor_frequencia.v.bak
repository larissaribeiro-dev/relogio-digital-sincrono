module divisor_frequencia #(parameter MAX = 24999999) (
    input clk_50mhz,
    input reset,
    output reg clk_1hz
);
    reg [24:0] contador;

    always @(posedge clk_50mhz or posedge reset) begin
        if (reset) begin
            contador <= 0;
            clk_1hz <= 0;
        end else if (contador == MAX) begin
            contador <= 0;
            clk_1hz <= ~clk_1hz;
        end else begin
            contador <= contador + 1;
        end
    end
endmodule